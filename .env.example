REKRUTMEN_JOB_APPLICATION_MAIL_REPLY_TO_ADDRESS=null
REKRUTMEN_JOB_APPLICATION_MAIL_REPLY_TO_NAME=null

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

FORM_TRANSFER_NOTIFICATION_QUEUE=notifications
EXIT_CLEARANCE_NOTIFICATION_QUEUE=notifications
REKRUTMEN_NOTIFICATION_QUEUE=notifications

NOTIFICATION_MAIL_THROTTLE_ENABLED=true
NOTIFICATION_MAIL_THROTTLE_MIN_INTERVAL=2
NOTIFICATION_MAIL_THROTTLE_MAX_INTERVAL=5
NOTIFICATION_MAIL_THROTTLE_KEY=global

WHATSAPP_ENABLED=false

# WhatsApp gateway: Gateway Hub primary, direct providers available as fallback
WHATSAPP_GATEWAY_PROVIDER=gateway_hub
WHATSAPP_GATEWAY_FALLBACK_PROVIDER=fonnte
WHATSAPP_GATEWAY_FALLBACK_ENABLED=true
WHATSAPP_GATEWAY_HUB_ENDPOINT=http://gateway-hub.test/api/v1/messages
WHATSAPP_GATEWAY_HUB_TOKEN=
WHATSAPP_GATEWAY_HUB_ROUTE_KEY=web-cesa-messages
WHATSAPP_GATEWAY_HUB_MODE=async
WHATSAPP_GATEWAY_WAHA_BASE_URL=http://localhost:3000
WHATSAPP_GATEWAY_WAHA_API_KEY=
WHATSAPP_GATEWAY_WAHA_SESSION=default
WHATSAPP_GATEWAY_FONNTE_ENDPOINT=https://api.fonnte.com/send
WHATSAPP_GATEWAY_FONNTE_TOKEN=
WHATSAPP_GATEWAY_COUNTRY_CODE=62
WHATSAPP_GATEWAY_TIMEOUT=15
WHATSAPP_GATEWAY_MIN_SECONDS_BETWEEN_SENDS=3

# Legacy aliases still supported for Fonnte token/endpoint
WHATSAPP_API_KEY=
WHATSAPP_API_ENDPOINT=https://api.fonnte.com/send
WHATSAPP_COUNTRY_CODE=62
WHATSAPP_QUEUE=whatsapp
WHATSAPP_CONNECTION=null
WHATSAPP_TIMEOUT=10
WHATSAPP_TRIES=3
WHATSAPP_BACKOFF=10,30,60
WHATSAPP_THROTTLE_ENABLED=true
WHATSAPP_THROTTLE_MIN_INTERVAL=5
WHATSAPP_THROTTLE_MAX_INTERVAL=10
WHATSAPP_THROTTLE_KEY=global
LEAD_WHATSAPP_VALIDATION_PROVIDER=gateway_hub
LEAD_WHATSAPP_VALIDATION_ENDPOINT=http://gateway-hub.test/api/v1/number-checks
LEAD_WHATSAPP_VALIDATION_TOKEN=
LEAD_WHATSAPP_VALIDATION_ROUTE_KEY=lead-number-check
WHATSAPP_VALIDATION_TIMEOUT=5
WHATSAPP_VALIDATION_CACHE_TTL=300
WHATSAPP_VALIDATION_ALLOW_MANUAL=true
WHATSAPP_VALIDATION_RATE_LIMIT=10
WHATSAPP_VALIDATION_RATE_DECAY=60

