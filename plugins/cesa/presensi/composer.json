{
    "name": "cesa/presensi",
    "description": "Presensi management plugin for CESA.",
    "type": "library",
    "authors": [
        {"name": "apriansyahrs", "email": "apriansyah@rizqis.com"}
    ],
    "extra": {
        "laravel": {
            "providers": [
                "Cesa\\Presensi\\PresensiServiceProvider"
            ],
            "aliases": {}
        }
